<header class="bg-gray-400 border-b border-gray-600 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        @* start editing hereeeee *@
        <div class="flex items-center gap-8">
            <a class="text-xl font-bold tracking-tight text-white" asp-area="" asp-controller="Home" asp-action="Index">
                POS
            </a>
        </div>
        <div class="text-right">
            <div id="pos-clock" class="text-lg font-semibold text-white">
                --:--:--
            </div>
            <div id="pos-date" class="text-sm text-gray-200">
                Loading date...
            </div>

        </div>
    </div>
</header>

@* For the time function *@
<script>
    function updatePosTime() {
        const now = new Date();
        
        // time
        const timeStr = now.toLocaleTimeString([], { 
            hour: '2-digit', 
            minute: '2-digit', 
            second: '2-digit' 
        });
        
        // day and date
        const dateStr = now.toLocaleDateString([], { 
            weekday: 'long', 
            year: 'numeric', 
            month: 'short', 
            day: 'numeric' 
        });

        const clockEl = document.getElementById('pos-clock');
        const dateEl = document.getElementById('pos-date');
        
        if (clockEl) clockEl.textContent = timeStr;
        if (dateEl) dateEl.textContent = dateStr;
    }

    updatePosTime();
    setInterval(updatePosTime, 1000);
</script>