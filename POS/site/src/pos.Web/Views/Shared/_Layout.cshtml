<!DOCTYPE html>
<html lang="en" class="h-full overflow-hidden">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POS</title>
    @* Tailwind caller*@
    <script src="https://cdn.tailwindcss.com"></script>
    @*I fucking hate scrollbars, eliminate them!*@
    <style>
        ::-webkit-scrollbar {
            width: 0px;
            background: transparent;
        }
    </style>
</head>

    @*body*@
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col font-sans">

    @* _header.cshtml (dahil ganto format mo yule, ganto na din ginawa ko, start with _) file mentioned *@
    <partial name="_Header" />

    @* main area *@
    <main role="main" class="flex-1 w-full overflow-hidden">
        @RenderBody()
    </main>

    @* feet enjoyers in the chat *@
    <footer class="border-t border-gray-200 bg-white py-4 text-center text-sm text-gray-500">
        &copy; 2026 - POS - <a class="text-blue-600 hover:underline" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>