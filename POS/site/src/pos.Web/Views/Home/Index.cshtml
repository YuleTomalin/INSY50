        new Product {Name = "Cocaine (1KG)", Price = 15000, ImageUrl = "/images/coke.png", Category = "Desserts" },
        new Product {Name = "Strawblueberry Juice", Price = 85, ImageUrl = "/images/juice.png", Category = "Drinks" },
        new Product {Name = "Ang BLACK ni Bluejay", Price = 200000, ImageUrl = "/images/black.png", Category = "Desserts" },
        new Product {Name = "Pancake", Price = 140, ImageUrl = "/images/pancake.png", Category = "Desserts" },
